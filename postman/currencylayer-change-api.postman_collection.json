    {
      "name": "change",
      "item": [
        {
          "name": "Get Currency Change Data",
          "id": "6adccd11-fb67-4c32-bac7-aa70d626a784",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/change?start_date=<date>&end_date=<date>&currencies=<string>&source=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "change"
              ],
              "query": [
                {
                  "description": "Start date for the change window (YYYY-MM-DD). Defaults to yesterday.",
                  "key": "start_date",
                  "value": "<date>"
                },
                {
                  "description": "End date for the change window (YYYY-MM-DD). Defaults to today.",
                  "key": "end_date",
                  "value": "<date>"
                },
                {
                  "description": "(Required) Comma-separated ISO 4217 currency codes to report on.",
                  "key": "currencies",
                  "value": "<string>"
                },
                {
                  "description": "Three-letter ISO 4217 source/base currency code. Defaults to USD on the Free\nplan; any source currency may be selected on Basic plan and above.\n",
                  "key": "source",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns currency change parameters (start rate, end rate, absolute change,\npercentage change) between two dates for any supported currency pair.\nAvailable on Enterprise Plus plan and above.\n"
          },
