{
  "opencollection": "1.0.0",
  "info": {
    "name": "Currencylayer Change Symbols API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Symbols",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Supported Currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apilayer.com/currency_data/list"
          },
          "docs": "Returns the full list of currencies Currencylayer supports along with their\nfull names. Available on every plan including Free.\n"
        }
      ]
    }
  ],
  "bundled": true
}