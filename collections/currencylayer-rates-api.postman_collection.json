          "id": "fbffb62d-ae9c-4b52-9072-384717c0540c",
          "name": "Get Historical Exchange Rates",
          "request": {
            "name": "Get Historical Exchange Rates",
            "description": {
              "content": "Returns end-of-day historical exchange rates for any date since 1999.\nAvailable on every plan including Free.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "historical"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "(Required) ISO-8601 date in `YYYY-MM-DD` format (any working day since 1999)."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 source/base currency code. Defaults to USD on the Free\nplan; any source currency may be selected on Basic plan and above.\n"
                },
                {
                  "disabled": false,
                  "key": "currencies",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set."
