      "item": [
        {
          "name": "Get Time-Frame Exchange Rates",
          "id": "26d59db2-31bc-4cac-abf3-4252c24d79fd",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/timeframe?start_date=<date>&end_date=<date>&source=<string>&currencies=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "timeframe"
              ],
              "query": [
                {
                  "description": "(Required) Start date for the time-frame window (YYYY-MM-DD).",
                  "key": "start_date",
                  "value": "<date>"
                },
                {
                  "description": "(Required) End date for the time-frame window (YYYY-MM-DD).",
                  "key": "end_date",
                  "value": "<date>"
                },
                {
                  "description": "Three-letter ISO 4217 source/base currency code. Defaults to USD on the Free\nplan; any source currency may be selected on Basic plan and above.\n",
                  "key": "source",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set.",
                  "key": "currencies",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns daily historical exchange rates between two dates of your choice,\nwith a maximum range of 365 days. Available on Enterprise plan and above.\n"
          },
