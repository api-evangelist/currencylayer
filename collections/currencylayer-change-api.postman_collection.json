      "name": "Change",
      "description": {
        "content": "Currency change (margin and percentage) analysis between two dates.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c77b926d-941e-4dfa-b6e7-1ae2cf108df5",
          "name": "Get Currency Change Data",
          "request": {
            "name": "Get Currency Change Data",
            "description": {
              "content": "Returns currency change parameters (start rate, end rate, absolute change,\npercentage change) between two dates for any supported currency pair.\nAvailable on Enterprise Plus plan and above.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "change"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Start date for the change window (YYYY-MM-DD). Defaults to yesterday."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End date for the change window (YYYY-MM-DD). Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "currencies",
                  "value": "<string>",
                  "description": "(Required) Comma-separated ISO 4217 currency codes to report on."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Three-letter ISO 4217 source/base currency code. Defaults to USD on the Free\nplan; any source currency may be selected on Basic plan and above.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
