      "item": [
        {
          "name": "Get Live Exchange Rates",
          "id": "93e5a29f-56f7-44dc-996d-c57c83f1db1a",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/live?source=<string>&currencies=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "live"
              ],
              "query": [
                {
                  "description": "Three-letter ISO 4217 source/base currency code. Defaults to USD on the Free\nplan; any source currency may be selected on Basic plan and above.\n",
                  "key": "source",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of ISO 4217 currency codes to limit the result set.",
                  "key": "currencies",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns the most recent exchange rate data. Rates refresh every 60 minutes\non Free and Basic, every 10 minutes on Professional, and every 60 seconds\non Enterprise and above.\n"
          },
          "response": [
            {
              "id": "1f697cce-d8de-4d28-b872-b3e08d13ab30",
              "name": "Latest rates anchored to the requested source currency.",
